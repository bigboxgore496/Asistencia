from datetime import date, datetime, timedelta
import random
import sqlite3

# Conexión a la base de datos local
conn = sqlite3.connect("asistencia.db")
cursor = conn.cursor()

# Seleccionar un empleado activo de prueba (ej. el primer empleado)
emp = cursor.execute("SELECT id FROM employees LIMIT 1").fetchone()
if not emp:
  print("No hay empleados en la base de datos.")
  exit()

emp_id = emp[0]

# Limpiar registros previos de prueba de este empleado si se desea
cursor.execute("DELETE FROM attendance WHERE employee_id = ?", (emp_id,))

# Simular los últimos 30 días hacia atrás desde hoy
hoy = date.today()
for i in range(30):
  dia_actual = hoy - timedelta(days=30 - i)
  fecha_str = dia_actual.isoformat()

  # 1. Registrar Entrada fija a las 07:00 a.m.
  dt_entrada = datetime.combine(dia_actual, datetime.min.time()).replace(
      hour=7, minute=0, second=0
  )
  cursor.execute(
      """
        INSERT INTO attendance (employee_id, event_type, event_time, latitude, longitude, distance_m, gps_valid, status, late_minutes, overtime_minutes, project_code)
        VALUES (?, 'Entrada', ?, 6.21411, -75.58268, 10.0, 1, 'A tiempo', 0, 0, '')
    """,
      (emp_id, dt_entrada.isoformat()),
  )

  # 2. Simular hora de salida aleatoria para generar distintos tipos de extras
  # Opciones de salida: 15:00 (A tiempo), 18:00 (Extra Diurna), 21:00 (Extra Nocturna)
  hora_salida_opciones = [15, 15, 18, 19, 21]
  h_salida = random.choice(hora_salida_opciones)
  m_salida = random.randint(0, 45) if h_salida > 15 else 0

  dt_salida = datetime.combine(dia_actual, datetime.min.time()).replace(
      hour=h_salida, minute=m_salida, second=0
  )

  # Calcular minutos extras respecto a las 15:00 (asumiendo turno estándar que termina a las 15:00)
  minutos_totales_salida = h_salida * 60 + m_salida
  minutos_turno_fin = 15 * 60
  extra_mins = max(0, minutos_totales_salida - minutos_turno_fin)

  status_salida = "A tiempo" if extra_mins == 0 else f"Hora extra {extra_mins} min"
  proj_code = "DA 149" if extra_mins > 0 else ""

  cursor.execute(
      """
        INSERT INTO attendance (employee_id, event_type, event_time, latitude, longitude, distance_m, gps_valid, status, late_minutes, overtime_minutes, project_code)
        VALUES (?, 'Salida', ?, 6.21411, -75.58268, 10.0, 1, ?, 0, ?, ?)
    """,
      (emp_id, dt_salida.isoformat(), status_salida, extra_mins, proj_code),
  )

conn.commit()
conn.close()
print("¡Simulación de 30 días completada con éxito para el empleado ID:", emp_id)
